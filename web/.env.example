DATABASE_URL=file:./data/goalset.db
AUTH_SECRET=replace-with-a-long-random-secret
OWNER_PASSWORD=replace-before-public-access
# Set to true only for a trusted local/private network. Everyone with network access gets owner permissions.
AUTH_DISABLED=false
# Optional override; defaults to Secure only when the request uses HTTPS.
AUTH_COOKIE_SECURE=

# Optional AI provider
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Optional official QQ Bot
QQBOT_APP_ID=
QQBOT_APP_SECRET=
QQBOT_OWNER_USER_ID=

# Optional Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
